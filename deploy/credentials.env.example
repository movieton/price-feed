# Copy to /etc/price-feed/credentials.env (outside repository), chmod 600.
# Option A: app and store in same Shopify organization, automatic token exchange.
SHOPIFY_CLIENT_ID=REPLACE_ME
SHOPIFY_CLIENT_SECRET=REPLACE_ME
# Option B: existing valid offline Admin token; omit A and uncomment B.
# SHOPIFY_ADMIN_TOKEN=REPLACE_ME
